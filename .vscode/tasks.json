{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Guidard : synchronisation automatique",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\Watch-And-Sync.ps1",
        "-DebounceSeconds",
        "60"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen",
        "instanceLimit": 1
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "dedicated",
        "clear": false
      },
      "problemMatcher": []
    }
  ]
}
